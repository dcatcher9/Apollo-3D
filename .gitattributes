# ensure Linux specific files are checked out with LF line endings
Dockerfile text eol=lf
*.dockerfile text eol=lf
*flatpak-lint-*.json text eol=lf
*.sh text eol=lf

# Unified-diff context lines intentionally contain a single prefix space.
cmake/patches/*.patch -whitespace

# Neural-network weights are binary assets; never apply line-ending or text filters.
*.onnx -text
