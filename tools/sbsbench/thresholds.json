    "exact_visible_pop_spread_pct": {
      "scope": "style",
      "role": "diagnostic",
      "axis": "stereo",
      "requires": "exact_visible_support_count",
      "better": "higher",
      "rel_tol": 0.15,
      "abs_floor": 0.04
    },
    "exact_binocular_support_pct": {
      "scope": "conformance",
      "role": "hard",
      "axis": "stereo-evidence",
      "better": "higher",
      "rel_tol": 0.0,
      "abs_floor": 0.25,
      "hard_min": 80.0,
      "trigger_min": 80.0
    },
    "exact_positive_disparity_pct": {
      "scope": "perceptual",
      "role": "hard",
      "label": "hard",
      "label_status": "experimental",
      "axis": "comfort",
      "requires": "exact_binocular_support_count",
      "better": "lower",
      "rel_tol": 0.0,
      "abs_floor": 0.1,
      "hard_max": 3.0,
      "trigger": 3.0
    },
