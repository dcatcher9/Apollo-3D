// Configured once per synthetic Streamline release (CMakeLists.txt, interposer
// fixtures): its version resource is what production discovery reads.
#include <winver.h>
1 VERSIONINFO
FILEVERSION @fixture_version@
PRODUCTVERSION @fixture_version@
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Sunshine TEST ONLY frame-generation metadata fixture\0"
      VALUE "FileVersion", "@fixture_version_text@\0"
      VALUE "ProductVersion", "@fixture_version_text@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
