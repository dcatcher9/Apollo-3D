# Both consumers use this one algorithm. The Game 3D copy is materialized because
# its embedded/replay compiler intentionally accepts a self-contained source.
if(NOT DEFINED SHARED_UI_PIN_OWNER)
  set(SHARED_UI_PIN_OWNER "${CMAKE_CURRENT_LIST_DIR}/../../src_assets/windows/assets/shaders/directx/include/ui_pin_band_shared.hlsl")
endif()
if(NOT DEFINED SHARED_UI_PIN_GAME3D)
  set(SHARED_UI_PIN_GAME3D "${CMAKE_CURRENT_LIST_DIR}/game3d_native.hlsl")
endif()
file(READ "${SHARED_UI_PIN_OWNER}" shared_ui_pin_owner)
file(READ "${SHARED_UI_PIN_GAME3D}" shared_ui_pin_game3d)
string(REPLACE "\r\n" "\n" shared_ui_pin_owner "${shared_ui_pin_owner}")
string(REPLACE "\r\n" "\n" shared_ui_pin_game3d "${shared_ui_pin_game3d}")
set(shared_ui_pin_begin "// BEGIN GENERATED SHARED UI PIN BAND")
set(shared_ui_pin_end "// END GENERATED SHARED UI PIN BAND")
string(REGEX MATCHALL "${shared_ui_pin_begin}" shared_ui_pin_begins "${shared_ui_pin_game3d}")
string(REGEX MATCHALL "${shared_ui_pin_end}" shared_ui_pin_ends "${shared_ui_pin_game3d}")
list(LENGTH shared_ui_pin_begins shared_ui_pin_begin_count)
list(LENGTH shared_ui_pin_ends shared_ui_pin_end_count)
set(shared_ui_pin_expected "${shared_ui_pin_begin}\n${shared_ui_pin_owner}${shared_ui_pin_end}")
string(FIND "${shared_ui_pin_game3d}" "${shared_ui_pin_expected}" shared_ui_pin_offset)
if(NOT shared_ui_pin_begin_count EQUAL 1 OR NOT shared_ui_pin_end_count EQUAL 1 OR shared_ui_pin_offset EQUAL -1)
  message(FATAL_ERROR "Game 3D UI pin band differs from its shared owner. Run tools/reshade/generate_ui_pin_band.py")
endif()
