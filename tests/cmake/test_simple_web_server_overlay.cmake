cmake_minimum_required(VERSION 3.20)

if(NOT REPO_SOURCE_DIR OR NOT TEST_BINARY_DIR)
    message(FATAL_ERROR "REPO_SOURCE_DIR and TEST_BINARY_DIR are required")
endif()
find_program(ninja_executable ninja REQUIRED)
find_package(Git REQUIRED)
set(fixture_dir "${TEST_BINARY_DIR}/overlay fixture")
set(input_dir "${fixture_dir}/inputs")
set(project_dir "${fixture_dir}/project")
set(build_dir "${fixture_dir}/build")
set(output_dir "${build_dir}/include/Simple-Web-Server")
set(patch_file "${fixture_dir}/request-limit.patch")
file(MAKE_DIRECTORY "${input_dir}" "${project_dir}")
file(GLOB input_headers "${REPO_SOURCE_DIR}/third-party/Simple-Web-Server/*.hpp")
foreach(header IN LISTS input_headers)
    get_filename_component(name "${header}" NAME)
    configure_file("${header}" "${input_dir}/${name}" COPYONLY)
endforeach()
configure_file("${REPO_SOURCE_DIR}/cmake/patches/simple-web-server-request-limit.patch"
        "${patch_file}" COPYONLY)
file(WRITE "${project_dir}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.20)
project(overlay_fixture NONE)
include("${REPO_SOURCE_DIR}/cmake/dependencies/simple_web_server_overlay.cmake")
sunshine_prepare_simple_web_server_overlay(
    "${INPUT_DIR}" "${PATCH_FILE}" "${CMAKE_BINARY_DIR}/include/Simple-Web-Server")
message(STATUS "Overlay fixture configured")
add_custom_target(overlay_ready ALL COMMAND "${CMAKE_COMMAND}" -E true)
]=])
set(configure_command "${CMAKE_COMMAND}" -S "${project_dir}" -B "${build_dir}" -G Ninja
        "-DCMAKE_MAKE_PROGRAM=${ninja_executable}"
        "-DGIT_EXECUTABLE=${GIT_EXECUTABLE}"
        "-DREPO_SOURCE_DIR=${REPO_SOURCE_DIR}" "-DINPUT_DIR=${input_dir}" "-DPATCH_FILE=${patch_file}")

function(configure_fixture)
    execute_process(COMMAND ${configure_command} RESULT_VARIABLE result
            OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Fixture configure failed:\n${output}${error}")
    endif()
endfunction()

function(build_fixture expect_reconfigure)
    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${build_dir}" RESULT_VARIABLE result
            OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Fixture build failed:\n${output}${error}")
    endif()
    if(expect_reconfigure AND NOT output MATCHES "Overlay fixture configured")
        message(FATAL_ERROR "Input change did not reconfigure the fixture:\n${output}${error}")
    elseif(NOT expect_reconfigure AND output MATCHES "Overlay fixture configured")
        message(FATAL_ERROR "Unchanged fixture unexpectedly reconfigured:\n${output}${error}")
    endif()
endfunction()

function(snapshot result_variable directory)
    set(entries)
    foreach(header IN LISTS input_headers)
        get_filename_component(name "${header}" NAME)
        file(SHA256 "${directory}/${name}" hash)
        file(TIMESTAMP "${directory}/${name}" timestamp "%s")
        list(APPEND entries "${name}|${hash}|${timestamp}")
    endforeach()
    set(${result_variable} "${entries}" PARENT_SCOPE)
endfunction()

function(require_text path text)
    file(READ "${path}" content)
    string(FIND "${content}" "${text}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Expected '${text}' in ${path}")
    endif()
endfunction()

snapshot(original_inputs "${input_dir}")
configure_fixture()
require_text("${output_dir}/server_http.hpp" "request_content_length_limit")
snapshot(initial_snapshot "${output_dir}")
# Cross a filesystem timestamp second so rewriting identical bytes cannot pass this check.
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1.1)
configure_fixture()
build_fixture(FALSE)
build_fixture(FALSE)
snapshot(unchanged_snapshot "${output_dir}")
if(NOT initial_snapshot STREQUAL unchanged_snapshot)
    message(FATAL_ERROR "Unchanged configure altered published header bytes or timestamps")
endif()
snapshot(current_inputs "${input_dir}")
if(NOT original_inputs STREQUAL current_inputs)
    message(FATAL_ERROR "Overlay preparation altered pristine inputs")
endif()

# Upstream inputs and the patch must remain automatic CMake reconfigure dependencies.
file(APPEND "${input_dir}/utility.hpp" "\n// Overlay input dependency probe\n")
snapshot(changed_inputs "${input_dir}")
build_fixture(TRUE)
require_text("${output_dir}/utility.hpp" "Overlay input dependency probe")
snapshot(before_patch_touch "${output_dir}")
set(untouched_before "${unchanged_snapshot}")
set(untouched_after "${before_patch_touch}")
list(FILTER untouched_before EXCLUDE REGEX "^utility[.]hpp[|]")
list(FILTER untouched_after EXCLUDE REGEX "^utility[.]hpp[|]")
if(NOT untouched_before STREQUAL untouched_after)
    message(FATAL_ERROR "Changing one input rewrote unrelated published headers")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1.1)
file(TOUCH "${patch_file}")
build_fixture(TRUE)
snapshot(after_patch_touch "${output_dir}")
if(NOT before_patch_touch STREQUAL after_patch_touch)
    message(FATAL_ERROR "Touching an unchanged patch altered published headers")
endif()

file(READ "${patch_file}" valid_patch)
string(REPLACE "Optional per-request content limit" "Optional per-request body limit"
        changed_patch "${valid_patch}")
if(changed_patch STREQUAL valid_patch)
    message(FATAL_ERROR "Patch dependency probe could not find its expected addition")
endif()
file(WRITE "${patch_file}" "${changed_patch}")
build_fixture(TRUE)
require_text("${output_dir}/server_http.hpp" "Optional per-request body limit")
snapshot(after_valid_patch "${output_dir}")
set(untouched_before "${after_patch_touch}")
set(untouched_after "${after_valid_patch}")
list(FILTER untouched_before EXCLUDE REGEX "^server_http[.]hpp[|]")
list(FILTER untouched_after EXCLUDE REGEX "^server_http[.]hpp[|]")
if(NOT untouched_before STREQUAL untouched_after)
    message(FATAL_ERROR "Changing the patch rewrote unrelated published headers")
endif()
file(SHA256 "${output_dir}/server_http.hpp" canonical_hash)

file(REMOVE "${output_dir}/server_http.hpp")
configure_fixture()
file(SHA256 "${output_dir}/server_http.hpp" restored_hash)
if(NOT restored_hash STREQUAL canonical_hash)
    message(FATAL_ERROR "Reconfigure did not restore the missing generated header")
endif()
file(APPEND "${output_dir}/server_http.hpp" "\n// Damaged generated output\n")
configure_fixture()
file(SHA256 "${output_dir}/server_http.hpp" repaired_hash)
if(NOT repaired_hash STREQUAL canonical_hash)
    message(FATAL_ERROR "Reconfigure did not repair the generated header")
endif()

snapshot(before_failure "${output_dir}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1.1)
file(WRITE "${patch_file}" "Invalid patch input\n")
execute_process(COMMAND ${configure_command} RESULT_VARIABLE result
        OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT "${output}${error}" MATCHES "Could not build the Simple-Web-Server request-limit overlay")
    message(FATAL_ERROR "Invalid patch did not produce the expected fatal error:\n${output}${error}")
endif()
snapshot(after_failure "${output_dir}")
if(NOT before_failure STREQUAL after_failure)
    message(FATAL_ERROR "Failed patch altered published headers")
endif()

# Leave the fixture valid so the test can run repeatedly in the same build directory.
file(WRITE "${patch_file}" "${changed_patch}")
execute_process(COMMAND ${configure_command} "-DGIT_EXECUTABLE=${CMAKE_COMMAND}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT "${output}${error}" MATCHES "Could not initialize the Simple-Web-Server overlay")
    message(FATAL_ERROR "Git init failure did not produce the expected fatal error:\n${output}${error}")
endif()
snapshot(after_init_failure "${output_dir}")
if(NOT before_failure STREQUAL after_init_failure)
    message(FATAL_ERROR "Failed Git init altered published headers")
endif()
configure_fixture()
build_fixture(FALSE)
snapshot(final_inputs "${input_dir}")
if(NOT changed_inputs STREQUAL final_inputs)
    message(FATAL_ERROR "Overlay preparation altered its input headers")
endif()
message(STATUS "Simple-Web-Server overlay regression checks passed")
