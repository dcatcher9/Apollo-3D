        float sum = PaletteBias0[i];
        [unroll] for (uint j = 0; j < 50; ++j) sum += PaletteWeight0[i * 50 + j] * features[j];
        hidden[i] = max(0.0f, sum);
    }
    float activation[32];
    [unroll] for (uint i = 0; i < 32; ++i) {
        float sum = PaletteBias1[i];
        [unroll] for (uint j = 0; j < 48; ++j) sum += PaletteWeight1[i * 48 + j] * hidden[j];
        activation[i] = max(0.0f, sum);
    }
    float logit = PaletteBias2[0];
    [unroll] for (uint j = 0; j < 32; ++j) logit += PaletteWeight2[j] * activation[j];
    return 1.0f / (1.0f + exp(-logit));
}
#endif
